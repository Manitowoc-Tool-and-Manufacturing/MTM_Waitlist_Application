<Page
    x:Class="MTM_Waitlist_Server.Admin.Views.View_FirstRun"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel Margin="40,32,40,40" Spacing="24"
                    HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="⚙ First-Time Setup Required"
                           Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Complete the steps below before using the admin application."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>

            <!-- Step indicators -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border x:Name="Step1Indicator" CornerRadius="20" Width="40" Height="40"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontWeight="Bold" />
                </Border>
                <TextBlock Text="→" VerticalAlignment="Center" FontSize="18" />
                <Border x:Name="Step2Indicator" CornerRadius="20" Width="40" Height="40"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" />
                </Border>
                <TextBlock Text="→" VerticalAlignment="Center" FontSize="18" />
                <Border x:Name="Step3Indicator" CornerRadius="20" Width="40" Height="40"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" />
                </Border>
                <TextBlock x:Name="StepLabels" Text="Create DB  ·  Bootstrap Schema  ·  Create User"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- ── STEP 1 ── -->
            <StackPanel x:Name="PanelStep1" Spacing="16">
                <TextBlock Text="STEP 1 — Create Database &amp; Application Admin User"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Enter a privileged MySQL account (e.g. root) to create the database and application user. These credentials are used only during setup and are never saved."
                           Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />

                <!-- MySQL server location -->
                <TextBlock Text="MySQL Server" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DbHost, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DbPort, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Target Database Name" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DbName, Mode=TwoWay}" />
                </Grid>

                <!-- Privileged (root) credentials -->
                <TextBlock Text="Privileged Account (root / DBA)" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DbAdminUsername, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" />
                    <PasswordBox Grid.Row="1" Grid.Column="1"
                                 Password="{x:Bind ViewModel.DbAdminPassword, Mode=TwoWay}"
                                 LostFocus="AdminPassword_LostFocus" />
                </Grid>

                <!-- Application user to create -->
                <StackPanel x:Name="PanelAppUser" Spacing="8" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Application User to Create" FontWeight="SemiBold" />
                        <TextBlock Text="(already exists — creation skipped)"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                   Visibility="{x:Bind ViewModel.AppUserExists, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="This account will own the database and is used by the server at runtime."
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12"
                          Opacity="{x:Bind ViewModel.AppUserExists, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" VerticalAlignment="Center" />
                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DbAppUsername, Mode=TwoWay}"
                                   IsEnabled="{x:Bind ViewModel.AppUserExists, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center" />
                        <PasswordBox Grid.Row="1" Grid.Column="1"
                                     Password="{x:Bind ViewModel.DbAppPassword, Mode=TwoWay}"
                                     IsEnabled="{x:Bind ViewModel.AppUserExists, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Create Admin &amp; User"
                            Command="{x:Bind ViewModel.SetupDatabaseCommand}"
                            IsEnabled="{x:Bind ViewModel.IsWorking, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    <Button Content="Next →"
                            Command="{x:Bind ViewModel.GoToStep2Command}"
                            IsEnabled="{x:Bind ViewModel.Step1Complete, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!-- ── STEP 2 ── -->
            <StackPanel x:Name="PanelStep2" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="STEP 2 — Run Bootstrap Migration"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="This creates the mtm_waitlist database schema. Required before any other operation."
                           Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />

                <!-- Remind the user which privileged account will be used for DDL -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Running as:" VerticalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DbAdminUsername, Mode=OneWay}"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="@" VerticalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DbHost, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="(privileged account from Step 1)"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>

                <Button Content="▶ Run Bootstrap"
                        Command="{x:Bind ViewModel.RunBootstrapCommand}"
                        IsEnabled="{x:Bind ViewModel.IsWorking, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />

                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.MigrationLog, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.MigrationLog, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>

            <!-- ── STEP 3 ── -->
            <StackPanel x:Name="PanelStep3" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="STEP 3 — Create First Admin User"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows Username" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.WindowsUsername, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="App Username" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.AppUsername, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Display Name" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Role" VerticalAlignment="Center" />
                    <ComboBox  Grid.Row="3" Grid.Column="1"
                               ItemsSource="{x:Bind ViewModel.AvailableRoles, Mode=OneTime}"
                               SelectedItem="{x:Bind ViewModel.SelectedRole, Mode=TwoWay}"
                               HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Password" VerticalAlignment="Center" />
                    <PasswordBox Grid.Row="4" Grid.Column="1"
                                 Password="{x:Bind ViewModel.UserPassword, Mode=TwoWay}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Confirm Password" VerticalAlignment="Center" />
                    <PasswordBox Grid.Row="5" Grid.Column="1"
                                 Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}" />
                </Grid>

                <Button Content="✓ Create User &amp; Finish"
                        Command="{x:Bind ViewModel.CreateFirstUserCommand}"
                        IsEnabled="{x:Bind ViewModel.IsWorking, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>

            <!-- Status message (all steps) -->
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.StatusMessage, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />

            <!-- Busy indicator — collapsed when not working so it leaves no gap -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsWorking, Mode=OneWay}"
                          Width="32" Height="32"
                          HorizontalAlignment="Left"
                          Visibility="{x:Bind ViewModel.IsWorking, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MTM_Waitlist_Server.Admin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MTM_Waitlist_Server.Admin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MTM Waitlist Server Admin"
    >

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation shell -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Dashboard" Icon="Home" Content="Dashboard" />
                <NavigationViewItem Tag="Migrations" Icon="Sync" Content="Migrations" />
                <NavigationViewItem Tag="Backup" Icon="Save" Content="Backup &amp; Restore" />
                <NavigationViewItem Tag="KillSwitch" Icon="Cancel" Content="Kill Switch" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings" Icon="Setting" Content="Settings" />
            </NavigationView.FooterMenuItems>

            <!-- Content frame — modules are loaded here by navigation -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Persistent status bar -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- API status -->
                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="Green" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="1" x:Name="TxtApiStatus" Text="API Running on :5000" VerticalAlignment="Center" Margin="0,0,16,0" />

                <!-- DB status -->
                <Ellipse Grid.Column="2" Width="8" Height="8" Fill="Green" VerticalAlignment="Center" Margin="0,0,4,0" x:Name="DbStatusDot" />
                <TextBlock Grid.Column="3" x:Name="TxtDbStatus" Text="Connected — mtm_waitlist @ localhost:3306" VerticalAlignment="Center" />

                <!-- API controls -->
                <Button Grid.Column="4" Content="Start" Margin="0,0,4,0" Click="BtnStartApi_Click" />
                <Button Grid.Column="5" Content="Stop" Margin="0,0,4,0" Click="BtnStopApi_Click" />
                <Button Grid.Column="6" Content="Restart" Click="BtnRestartApi_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>

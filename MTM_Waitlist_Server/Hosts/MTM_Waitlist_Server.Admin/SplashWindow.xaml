<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MTM_Waitlist_Server.Admin.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MTM_Waitlist_Server.Admin"
    xmlns:models="using:MTM_Waitlist_Server.Core.Models.Splash"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MTM Waitlist Server — Starting…">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Root is the SplashWindow code-behind class.
        All x:Bind paths resolve against SplashWindow members.
        ViewModel properties are accessed via x:Bind ViewModel.PropertyName.
        Converters are declared globally in App.xaml.
    -->
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock
                Text="MTM Waitlist Server"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock
                Text="Admin Application"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- ── Indeterminate progress bar (visible while busy) ── -->
        <ProgressBar
            Grid.Row="1"
            IsIndeterminate="True"
            Margin="0,0,0,16"
            Visibility="{x:Bind ViewModel.IsBusyVisibility, Mode=OneWay}" />

        <!-- ── Step list (progress view, hidden when HasIssue) ── -->
        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.NoIssueVisibility, Mode=OneWay}">
            <ItemsControl
                ItemsSource="{x:Bind ViewModel.Steps, Mode=OneWay}"
                Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:StartupStep">
                        <Grid Margin="0,3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- State glyph — use runtime Binding so converters resolve from
                                 Application.Resources without requiring Window to be FrameworkElement. -->
                            <FontIcon
                                Grid.Column="0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Glyph="{Binding State, Converter={StaticResource StepStateToGlyphConverter}}"
                                Foreground="{Binding State, Converter={StaticResource StepStateToColorConverter}}" />

                            <!-- Step label -->
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind FriendlyLabel, Mode=OneTime}"
                                FontSize="13"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Issue view (visible when HasIssue) ── -->
        <StackPanel
            Grid.Row="2"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasIssueVisibility, Mode=OneWay}">

            <TextBlock
                Text="{x:Bind ViewModel.IssueTitle, Mode=OneWay}"
                FontSize="15"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

            <TextBlock
                Text="{x:Bind ViewModel.IssueDetail, Mode=OneWay}"
                FontSize="13"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Expandable diagnostics panel -->
            <Expander
                Header="Diagnostics log"
                IsExpanded="{x:Bind ViewModel.DiagnosticsExpanded, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                Margin="0,4,0,0">
                <ScrollViewer
                    MaxHeight="120"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        Text="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}"
                        FontFamily="Cascadia Mono, Consolas, Courier New"
                        FontSize="11"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
            </Expander>
        </StackPanel>

        <!-- ── Status message (always visible while busy) ── -->
        <TextBlock
            Grid.Row="3"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            FontSize="12"
            Margin="0,10,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{x:Bind ViewModel.IsBusyVisibility, Mode=OneWay}" />

        <!-- ── Action buttons ── -->
        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            Spacing="8"
            HorizontalAlignment="Right"
            Margin="0,16,0,0">

            <Button
                Content="Retry"
                Command="{x:Bind ViewModel.RetryCommand}"
                Visibility="{x:Bind ViewModel.CanRetryVisibility, Mode=OneWay}" />

            <Button
                Content="Open Setup Wizard"
                Command="{x:Bind ViewModel.OpenWizardCommand}"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.CanOpenWizardVisibility, Mode=OneWay}" />

            <Button
                Content="Open Degraded Mode"
                Command="{x:Bind ViewModel.OpenDegradedCommand}"
                Visibility="{x:Bind ViewModel.CanOpenDegradedVisibility, Mode=OneWay}" />

            <Button
                Content="Open Settings Folder"
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                Visibility="{x:Bind ViewModel.CanOpenSettingsVisibility, Mode=OneWay}" />

            <Button
                Content="View Log"
                Click="ViewLogButton_Click" />

            <Button
                x:Name="CancelButton"
                Content="Cancel"
                Command="{x:Bind ViewModel.CancelCommand}" />

        </StackPanel>
    </Grid>
</Window>

<Page
    x:Class="MTM_Waitlist_Server.Module.Dashboard.Views.View_Dashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MTM_Waitlist_Server.Module.Dashboard.ViewModels"
    xmlns:models="using:MTM_Waitlist_Server.Core.Models.Dashboard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

        <!--
        5-row Grid: rows 0-1 and 3-4 are Auto; row 2 (Active Connections) is *
        so it stretches to fill all remaining vertical space, pinning the
        activity log and toolbar to the bottom regardless of window height.
    -->
    <Grid Margin="16" RowSpacing="16"
          RowDefinitions="Auto,Auto, Auto,*,Auto">

        <!-- Row 0: Summary Cards -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

            <!-- Uptime -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="UPTIME"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ApiUptimeDisplay, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="since app start"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- DB Size -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="DB SIZE"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.DbSizeMb, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="mtm_waitlist"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Connections -->
            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="CONNECTIONS"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ActiveConnectionCount, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text=" / "
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MaxConnections, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="active / max"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Wait Requests -->
            <Border Grid.Column="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="WAIT REQUESTS"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}">
                        <Run Text="{x:Bind ViewModel.TotalRequestsToday, Mode=OneWay}" />
                        <Run Text=" total today" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                            <Run Text="{x:Bind ViewModel.OpenRequestCount, Mode=OneWay}" />
                            <Run Text=" open" />
                        </TextBlock>
                        <TextBlock Text="."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}">
                            <Run Text="{x:Bind ViewModel.OverdueRequestCount, Mode=OneWay}" />
                            <Run Text=" overdue" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Row 1: Table Status (fixed height) -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Grid.Row="0" Text="TABLE STATUS" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="4">
                <Grid Grid.Row="0" ColumnDefinitions="*,110,120,180" Margin="12,0,0,0">
                    <TextBlock Grid.Column="0" Text="Table"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Est. Rows"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Data Size"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Last Updated"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.TableStats, Mode=OneWay}"
                          SelectionMode="None" MaxHeight="200">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Model_TableStat">
                            <Grid ColumnDefinitions="*,110,120,180" Padding="0,4">
                                <TextBlock Grid.Column="0" Text="{x:Bind TableName, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind EstimatedRows, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DataSizeDisplay, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind LastUpdated, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Row 2: Active Connections - star-sized, fills all remaining space -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="4">
            <TextBlock Grid.Row="0" Text="ACTIVE CONNECTIONS" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Grid Grid.Row="1" ColumnDefinitions="80,140,140,110,90,*,80" Margin="12,0,0,0">
                <TextBlock Grid.Column="0" Text="Thread"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="User"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="Host"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="Command"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="Time (s)"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="5" Text="State"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="6" Text="Action"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <!-- No MaxHeight - ListView expands to fill the star row -->
            <ListView Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.ActiveConnections, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_ActiveConnection">
                        <Grid ColumnDefinitions="80,140,140,110,90,*,80" Padding="0,2">
                            <TextBlock Grid.Column="0" Text="{x:Bind ThreadId, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind User, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Host, Mode=OneWay}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Command, Mode=OneWay}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind TimeSeconds, Mode=OneWay}" />
                            <TextBlock Grid.Column="5" Text="{x:Bind State, Mode=OneWay}" />
                            <Button Grid.Column="6" Content="Kill" MinHeight="36"
                                    Tag="{x:Bind}" Click="KillButton_Click" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Row 3: Recent Activity Log (fixed height) -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="4">
            <TextBlock Grid.Row="0" Text="RECENT ACTIVITY LOG (last 20)"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.RecentActivity, Mode=OneWay}"
                      SelectionMode="None" MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LogEntry">
                        <TextBlock FontFamily="Consolas" FontSize="12">
                            <Run Text="{x:Bind TimestampUtc, Mode=OneWay}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="  " />
                            <Run Text="{x:Bind Method, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" " />
                            <Run Text="{x:Bind Path, Mode=OneWay}" />
                            <Run Text="  " />
                            <Run Text="{x:Bind StatusCode, Mode=OneWay}" />
                            <Run Text=" (" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="{x:Bind DurationMs, Mode=OneWay}" />
                            <Run Text="ms)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Row 4: Toolbar - always pinned to the bottom -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}">
                <Run Text="Last refreshed: " />
                <Run Text="{x:Bind ViewModel.LastRefreshedAt, Mode=OneWay}" />
            </TextBlock>
            <Button Content="Exact Row Counts" MinHeight="36"
                    Command="{x:Bind ViewModel.RefreshExactCommand, Mode=OneWay}" />
            <Button Content="Refresh" MinHeight="36"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" />
            <Button Content="Open Full Log" MinHeight="36"
                    Command="{x:Bind ViewModel.OpenFullLogCommand, Mode=OneWay}" />
        </StackPanel>

    </Grid>

</Page>


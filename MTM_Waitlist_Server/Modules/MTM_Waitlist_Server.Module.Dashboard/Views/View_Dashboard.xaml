<Page
    x:Class="MTM_Waitlist_Server.Module.Dashboard.Views.View_Dashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MTM_Waitlist_Server.Module.Dashboard.ViewModels"
    xmlns:models="using:MTM_Waitlist_Server.Core.Models.Dashboard"
    xmlns:conv="using:MTM_Waitlist_Server.Module.Dashboard.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Page.Resources>
        <conv:BoolNegationConverter x:Key="BoolNegationConverter" />
    </Page.Resources>

        <!--
        6-row Grid: row 0 is the API status banner (Auto); rows 1-2 and 4-5 are Auto;
        row 3 (Active Connections) is * so it stretches to fill remaining vertical space.
    -->
    <Grid Margin="16" RowSpacing="16"
          RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Row 0: API host status banner -->
        <!-- Shown as Informational (green) when running, Error (red) when not. -->
        <InfoBar Grid.Row="0"
                 Title="API Host — Running"
                 Message="{x:Bind ViewModel.ApiStatusMessage, Mode=OneWay}"
                 Severity="Informational"
                 IsOpen="{x:Bind ViewModel.IsApiRunning, Mode=OneWay}"
                 IsClosable="False" />
        <InfoBar Grid.Row="0"
                 Title="API Host — Not Running"
                 Message="{x:Bind ViewModel.ApiStatusMessage, Mode=OneWay}"
                 Severity="Error"
                 IsOpen="{x:Bind ViewModel.IsApiRunning, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                 IsClosable="False" />

        <!-- Row 1: Summary Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

            <!-- Uptime -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="UPTIME"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ApiUptimeDisplay, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="since app start"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- DB Size -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="DB SIZE"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.DbSizeMb, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="mtm_waitlist"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Connections -->
            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="CONNECTIONS"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ActiveConnectionCount, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text=" / "
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MaxConnections, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="active / max"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Wait Requests -->
            <Border Grid.Column="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="WAIT REQUESTS"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}">
                        <Run Text="{x:Bind ViewModel.TotalRequestsToday, Mode=OneWay}" />
                        <Run Text=" total today" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                            <Run Text="{x:Bind ViewModel.OpenRequestCount, Mode=OneWay}" />
                            <Run Text=" open" />
                        </TextBlock>
                        <TextBlock Text="."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}">
                            <Run Text="{x:Bind ViewModel.OverdueRequestCount, Mode=OneWay}" />
                            <Run Text=" overdue" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Row 2: Table Status -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Grid.Row="0" Text="TABLE STATUS" Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <!-- Table shell with border -->
            <Border Grid.Row="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <StackPanel>

                    <!-- Header row -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Padding="12,7,12,7"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,100,110,190">
                            <TextBlock Grid.Column="0" Text="Table"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Est. Rows"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Data Size"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Last Updated"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- Data rows -->
                    <ListView ItemsSource="{x:Bind ViewModel.TableStats, Mode=OneWay}"
                              SelectionMode="None" MaxHeight="200"
                              Padding="0" BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Model_TableStat">
                                <Grid ColumnDefinitions="*,100,110,190" MinHeight="32">
                                    <TextBlock Grid.Column="0" Text="{x:Bind TableName, Mode=OneTime}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind EstimatedRows, Mode=OneTime}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind DataSizeDisplay, Mode=OneTime}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind LastUpdated, Mode=OneTime}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 3: Active Connections - grouped by user, expandable thread detail -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">

            <!-- Section label + total thread count badge -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*">
                <TextBlock Grid.Column="0" Text="ACTIVE CONNECTIONS"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Margin="8,0,0,0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10" Padding="8,2">
                    <TextBlock Text="{x:Bind ViewModel.ActiveConnectionCount, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Grouped shell -->
            <Border Grid.Row="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid RowDefinitions="Auto,*">

                    <!-- Column header bar -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Padding="48,7,12,7"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,80">
                            <TextBlock Grid.Column="0" Text="User"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Threads"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- User group rows — each is an Expander -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.GroupedConnections, Mode=OneWay}"
                              SelectionMode="None" Padding="0" BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Model_ConnectionGroup">

                                <Expander HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Padding="0"
                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                          BorderThickness="0,0,0,1">

                                    <!-- Expander header — user name + thread count -->
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*,80" Padding="0,6,12,6">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind User, Mode=OneTime}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="10" Padding="8,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind ThreadCount, Mode=OneTime}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>

                                    <!-- Thread detail rows -->
                                    <StackPanel>

                                        <!-- Thread sub-header -->
                                        <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                Padding="12,5,12,5"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,1">
                                            <Grid ColumnDefinitions="70,160,90,70,*,70">
                                                <TextBlock Grid.Column="0" Text="Thread"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="Host"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="Command"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="3" Text="Time (s)"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="4" Text="State"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="5" Text="Action"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>

                                        <!-- Individual thread rows -->
                                        <ListView ItemsSource="{x:Bind Threads, Mode=OneTime}"
                                                  SelectionMode="None" Padding="0" BorderThickness="0">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="12,0" />
                                                    <Setter Property="MinHeight" Value="34" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:Model_ActiveConnection">
                                                <Grid ColumnDefinitions="70,160,90,70,*,70" MinHeight="30">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind ThreadId, Mode=OneTime}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind Host, Mode=OneTime}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind Command, Mode=OneTime}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{x:Bind TimeSeconds, Mode=OneTime}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{x:Bind State, Mode=OneTime}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="5" Content="Kill"
                                                                MinHeight="28" Padding="8,4"
                                                                IsEnabled="{x:Bind CanKill}"
                                                                ToolTipService.ToolTip="{x:Bind KillTooltip}"
                                                                Tag="{x:Bind}" Click="KillButton_Click" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                    </StackPanel>
                                </Expander>

                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>
        </Grid>

        <!-- Row 4: Recent Activity Log (fixed height) -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="4">
            <TextBlock Grid.Row="0" Text="RECENT ACTIVITY LOG (last 20)"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.RecentActivity, Mode=OneWay}"
                      SelectionMode="None" MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LogEntry">
                        <TextBlock FontFamily="Consolas" FontSize="12">
                            <Run Text="{x:Bind TimestampUtc, Mode=OneTime}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="  " />
                            <Run Text="{x:Bind Method, Mode=OneTime}" FontWeight="SemiBold" />
                            <Run Text=" " />
                            <Run Text="{x:Bind Path, Mode=OneTime}" />
                            <Run Text="  " />
                            <Run Text="{x:Bind StatusCode, Mode=OneTime}" />
                            <Run Text=" (" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="{x:Bind DurationMs, Mode=OneTime}" />
                            <Run Text="ms)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Row 5: Toolbar - always pinned to the bottom -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}">
                <Run Text="Last refreshed: " />
                <Run Text="{x:Bind ViewModel.LastRefreshedAt, Mode=OneWay}" />
            </TextBlock>
            <Button Content="Exact Row Counts" MinHeight="36"
                    Command="{x:Bind ViewModel.RefreshExactCommand, Mode=OneWay}" />
            <Button Content="Refresh" MinHeight="36"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" />
            <Button Content="Open Full Log" MinHeight="36"
                    Command="{x:Bind ViewModel.OpenFullLogCommand, Mode=OneWay}" />
        </StackPanel>

    </Grid>

</Page>


<Page
    x:Class="MTM_Waitlist_Server.Module.ConnectedUsers.Views.View_ConnectedUsers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MTM_Waitlist_Server.Module.ConnectedUsers.ViewModels"
    xmlns:models="using:MTM_Waitlist_Server.Core.Models.ConnectedUsers"
    xmlns:conv="using:MTM_Waitlist_Server.Module.ConnectedUsers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Page.Resources>
        <conv:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter" />
    </Page.Resources>

    <!--
        Two-column layout:
          Left  (320px) — scrollable user list with search/refresh toolbar
          Right (*     ) — detail panel for the selected user
    -->
    <Grid ColumnDefinitions="320,*" ColumnSpacing="0">

        <!-- ══ LEFT PANEL — User List ══════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              RowDefinitions="Auto,Auto,*"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">

            <!-- Header -->
            <Border Grid.Row="0" Padding="16,16,16,12"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Connected Users"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            ToolTipService.ToolTip="Refresh user list"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.LoadUsersCommand, Mode=OneWay}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>

            <!-- Loading indicator -->
            <ProgressBar Grid.Row="1"
                         IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- User list -->
            <ListView Grid.Row="2"
                      x:Name="UserListView"
                      ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}"
                      SelectionMode="Single"
                      HorizontalAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,8,12,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Model_ConnectedUser">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                            <!-- Avatar initial circle -->
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Initial}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Name + workstation -->
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Username}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind WorkstationName, TargetNullValue='Personal workstation'}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ══ RIGHT PANEL — Detail View ════════════════════════════════════════ -->
        <Grid Grid.Column="1">

            <!-- Empty state — no selection -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasSelectedUser, Converter={StaticResource BoolToInverseVisibilityConverter}, Mode=OneWay}">
                <FontIcon Glyph="&#xE8FB;"
                          FontSize="48"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Select a user to view details"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Detail content — visible when a user is selected -->
            <ScrollViewer Padding="32,24,32,24"
                          Visibility="{x:Bind ViewModel.HasSelectedUser, Mode=OneWay}">
                <StackPanel Spacing="20" MaxWidth="640">

                    <!-- Profile header -->
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                Width="64" Height="64"
                                CornerRadius="32"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                            <TextBlock FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.SelectedUser.Initial, Mode=OneWay, FallbackValue='?'}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SelectedUser.DisplayName, Mode=OneWay}"
                                       Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedUserRoleDisplay, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Info cards -->
                    <TextBlock Text="Account Information"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <!-- Username -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="18"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="App Username"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedUser.Username, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Windows Username -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Grid.Column="0" Glyph="&#xE770;" FontSize="18"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Windows Login"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedUser.WindowsUsername, Mode=OneWay, TargetNullValue='Not set — shared workstation login only'}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Workstation -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Workstation"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedUserWorkstationDisplay, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Role -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Grid.Column="0" Glyph="&#xE7EE;" FontSize="18"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Role"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedUserRoleDisplay, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Last Login -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="18"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Last Login"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedUserLastLoginDisplay, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

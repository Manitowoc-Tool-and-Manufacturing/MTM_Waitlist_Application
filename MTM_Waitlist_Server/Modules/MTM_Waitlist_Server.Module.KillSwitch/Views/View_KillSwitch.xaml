<Page
    x:Class="MTM_Waitlist_Server.Module.KillSwitch.Views.View_KillSwitch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:ks="using:MTM_Waitlist_Server.Core.Models.KillSwitch"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Margin="24,16,24,16" RowDefinitions="Auto,*" RowSpacing="16">

        <!-- Top toolbar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="Client Kill Switch" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Send graceful shutdown signals to connected MAUI clients."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="8">
                <Button Content="Refresh" MinHeight="36"
                        Command="{x:Bind ViewModel.RefreshClientsCommand, Mode=OneWay}" />
                <Button Content="Cancel All Signals" MinHeight="36"
                        Visibility="{x:Bind ViewModel.IsShutdownActive, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelShutdownCommand, Mode=OneWay}" />
                <Button Content="Shut Down All" MinHeight="36"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ShutDownAllCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="4" HorizontalAlignment="Stretch">

                <!-- RESTORE IN PROGRESS BANNER -->
                <InfoBar Title="Restore In Progress"
                         Message="Kill switch is locked while a database restore is running."
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.IsRestoreInProgress, Mode=OneWay}"
                         IsClosable="False" />

                <!-- SHUTDOWN ACTIVE BANNER -->
                <InfoBar Title="Shutdown Signal Active"
                         Message="A shutdown signal has been issued to one or more clients."
                         Severity="Error"
                         IsOpen="{x:Bind ViewModel.IsShutdownActive, Mode=OneWay}"
                         IsClosable="False" />

                <!-- SHUTDOWN CONFIGURATION -->
                <ctk:SettingsExpander Header="Shutdown Configuration"
                                      Description="Configure the shutdown warning and message before issuing">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard Header="Warning Time (seconds)"
                                          Description="How many seconds clients have to save work before shutdown">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE916;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <NumberBox Minimum="10" Maximum="600"
                                       SpinButtonPlacementMode="Inline"
                                       MinWidth="140"
                                       Value="{x:Bind ViewModel.SelectedWarningSeconds, Mode=TwoWay}" />
                        </ctk:SettingsCard>

                        <ctk:SettingsCard Header="Shutdown Message"
                                          Description="Message shown to users when the shutdown signal is received">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8BD;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <TextBox MinWidth="300"
                                     Text="{x:Bind ViewModel.ShutdownMessage, Mode=TwoWay}" />
                        </ctk:SettingsCard>

                        <ctk:SettingsCard Header="Shut Down All Clients"
                                          Description="Issue the shutdown signal to every connected client at once">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7E8;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <Button Content="Shut Down All" MinHeight="36"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ShutDownAllCommand, Mode=OneWay}" />
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- ACTIVE SIGNALS -->
                <ctk:SettingsExpander Header="Active Signals"
                                      Description="Shutdown signals currently pending for connected clients">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ListView ItemsSource="{x:Bind ViewModel.ActiveSignals, Mode=OneWay}"
                                      MinHeight="40" MaxHeight="200"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="ks:ActiveShutdownSignal">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                              Padding="0,4,0,4">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Target}"
                                                           Style="{ThemeResource BodyTextBlockStyle}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind MachineName}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="|"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind WarningSeconds}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="s warning |"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Message}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- CONNECTED CLIENTS -->
                <ctk:SettingsExpander Header="Connected Clients"
                                      Description="MAUI clients that have recently sent a heartbeat">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8FB;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ListView ItemsSource="{x:Bind ViewModel.ConnectedClients, Mode=OneWay}"
                                      MinHeight="40" MaxHeight="400"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="ks:ClientHeartbeat">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                              Padding="0,6,0,6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <!-- Full name (primary) -->
                                                <TextBlock Text="{x:Bind FullName}"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <!-- Username + machine -->
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind Username}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="&#x2022;"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind WorkstationName, TargetNullValue='Personal workstation'}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="&#x2022; Last seen:"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind LastSeenUtc}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <!-- Machine name (tertiary) -->
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Machine: " /><Run Text="{x:Bind MachineName}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Shut Down"
                                                    MinHeight="32"
                                                    VerticalAlignment="Center"
                                                    Tag="{x:Bind}"
                                                    Click="ShutDownClientButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<Page
    x:Class="MTM_Waitlist_Server.Module.Backup.Views.View_Backup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:backup="using:MTM_Waitlist_Server.Core.Models.Backup"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Margin="24,16,24,16" RowDefinitions="Auto,*" RowSpacing="16">

        <!-- Top toolbar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="Backup &amp; Restore" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Create, manage, and restore database backups."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="8">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="20" Height="20"
                              Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Refresh" MinHeight="36"
                        Command="{x:Bind ViewModel.RefreshHistoryCommand, Mode=OneWay}" />
                <Button Content="Backup Now" MinHeight="36"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.BackUpNowCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="4" HorizontalAlignment="Stretch">

                <!-- QUICK ACTIONS -->
                <ctk:SettingsExpander Header="Quick Actions"
                                      Description="Run manual backups or restore from a file">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard Header="Backup Now"
                                          Description="Create a full manual backup of the database immediately">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE896;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <Button Content="Run Backup" MinHeight="36"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.BackUpNowCommand, Mode=OneWay}" />
                        </ctk:SettingsCard>

                        <ctk:SettingsCard Header="Restore from File"
                                          Description="Browse for a backup file and restore the database">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <Button Content="Browse &amp; Restore" MinHeight="36"
                                    Command="{x:Bind ViewModel.RestoreFromFileCommand, Mode=OneWay}" />
                        </ctk:SettingsCard>

                        <ctk:SettingsCard Header="Open Backup Folder"
                                          Description="Open the backup storage directory in File Explorer">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xED25;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <Button Content="Open Folder" MinHeight="36"
                                    Command="{x:Bind ViewModel.BrowseBackupFolderCommand, Mode=OneWay}" />
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- RETENTION AND CLEANUP -->
                <ctk:SettingsExpander Header="Retention and Cleanup"
                                      Description="Remove old backup files to free disk space">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE74D;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard Header="Clear Backups Before Date"
                                          Description="Delete all backups created before the selected date">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE787;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CalendarDatePicker Date="{x:Bind ViewModel.SelectedClearDate, Mode=TwoWay}"
                                                    PlaceholderText="Select date" />
                                <Button Content="Clear Before Date" MinHeight="36"
                                        Command="{x:Bind ViewModel.ClearBackupsBeforeDateCommand, Mode=OneWay}" />
                            </StackPanel>
                        </ctk:SettingsCard>

                        <ctk:SettingsCard Header="Clear All Backups"
                                          Description="Permanently delete every backup file — this cannot be undone">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE74D;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <Button Content="Clear All" MinHeight="36"
                                    Command="{x:Bind ViewModel.ClearAllBackupsCommand, Mode=OneWay}" />
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- OPERATION LOG -->
                <ctk:SettingsExpander Header="Operation Log"
                                      Description="{x:Bind ViewModel.OperationLogDescription, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.HasProgressLines, Mode=OneWay}">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ListView ItemsSource="{x:Bind ViewModel.ProgressLines, Mode=OneWay}"
                                      MinHeight="80" MaxHeight="200"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}"
                                                   FontFamily="Consolas"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- BACKUP HISTORY -->
                <ctk:SettingsExpander Header="Backup History"
                                      Description="All backup files found in the configured backup directory">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ListView ItemsSource="{x:Bind ViewModel.BackupHistory, Mode=OneWay}"
                                      MinHeight="60" MaxHeight="400"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="backup:BackupFileInfo">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12"
                                              Padding="0,4,0,4">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind FileName}"
                                                           Style="{ThemeResource BodyTextBlockStyle}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind CreatedAt}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="|"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind SizeBytes}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="bytes |"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Type}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="Checksum OK"
                                                       VerticalAlignment="Center"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       Visibility="{x:Bind HasChecksum, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Button Grid.Column="2"
                                                    Content="Restore"
                                                    MinHeight="32"
                                                    Tag="{x:Bind}"
                                                    Click="RestoreButton_Click" />
                                            <Button Grid.Column="3"
                                                    Content="Delete"
                                                    MinHeight="32"
                                                    Tag="{x:Bind}"
                                                    Click="DeleteButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

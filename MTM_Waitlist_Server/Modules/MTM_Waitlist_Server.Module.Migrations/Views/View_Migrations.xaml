<Page
    x:Class="MTM_Waitlist_Server.Module.Migrations.Views.View_Migrations"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:mig="using:MTM_Waitlist_Server.Core.Models.Migration"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Margin="24,16,24,16" RowDefinitions="Auto,Auto,*" RowSpacing="8">

        <!-- Top toolbar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="Database Schema Updates" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Compare checked-in SQL object files to the live database, then apply safe updates."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="8">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="20" Height="20"
                              Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <Button Content="Refresh" MinHeight="36"
                        Command="{x:Bind ViewModel.LoadCommand, Mode=OneWay}" />
                <Button Content="Apply Updates" MinHeight="36"
                        Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanApplyPendingMigrations, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ApplyMigrationsCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Status bar — spans full width, shown only when there is a message -->
        <InfoBar Grid.Row="1"
                 Title="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 IsClosable="False"
                 Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

        <!-- Body -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="4" HorizontalAlignment="Stretch">

                <!-- SCHEMA VERSIONS TABLE WARNING -->
                <InfoBar Title="Update History Table Missing"
                         Message="The SchemaVersions tracking table does not exist yet. It will be created automatically once the baseline schema exists."
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.IsSchemaVersionsTableMissing, Mode=OneWay}"
                         IsClosable="False" />

                <!-- PENDING MIGRATIONS -->
                <ctk:SettingsExpander Header="Pending Updates"
                                      Description="{x:Bind ViewModel.PendingUpdatesDescription, Mode=OneWay}">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8A9;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <Button Content="Apply All" MinHeight="36"
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanApplyPendingMigrations, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ApplyMigrationsCommand, Mode=OneWay}" />
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <StackPanel Spacing="8">
                                <TextBlock Text="No pending updates. The live database currently matches the checked-in SQL definitions."
                                           Visibility="{x:Bind ViewModel.HasPendingMigrations, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource BodyTextBlockStyle}" />
                                <ListView ItemsSource="{x:Bind ViewModel.PendingMigrations, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.HasPendingMigrations, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                      MinHeight="40" MaxHeight="300"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="mig:PendingMigration">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                                              Padding="0,4,0,4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Version}"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{x:Bind Description}"
                                                           Style="{ThemeResource BodyTextBlockStyle}"
                                                           TextWrapping="WrapWholeWords" />
                                                <TextBlock Text="{x:Bind AutoApplySummary}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind DetailSummary}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="Preview Details"
                                                    MinHeight="32"
                                                    Tag="{x:Bind}"
                                                    Click="PreviewButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- SQL PREVIEW -->
                <ctk:SettingsExpander Header="SQL Preview"
                                      Description="SQL content of the selected stored definition">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ScrollViewer MaxHeight="300" HorizontalScrollMode="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ViewModel.SqlPreview, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- IDEMPOTENT OBJECTS -->
                <ctk:SettingsExpander Header="Replaceable Objects"
                                      Description="Apply pending procedures, triggers, and missing indexes without rebuilding tables">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard Header="Apply Replaceable Updates"
                                          Description="Applies the pending definitions that can be safely replaced without altering live table structures">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE72C;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <Button Content="Apply Replaceable Updates" MinHeight="36"
                                    Command="{x:Bind ViewModel.RerunIdempotentObjectsCommand, Mode=OneWay}" />
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- DANGER ZONE -->
                <ctk:SettingsExpander Header="Danger Zone"
                                      Description="Irreversible recovery actions for a broken or unrecoverable database state">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard Header="Wipe Database"
                                          Description="Drops the entire configured database, recreates it empty, and re-enables first-run setup.">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE74D;" Foreground="#FFC62828" />
                            </ctk:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="8">
                                <TextBlock Text="This permanently deletes every table, row, procedure, trigger, and migration record in the configured database."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource BodyTextBlockStyle}" />
                                <Button Content="Wipe Database"
                                        MinHeight="36"
                                        Background="#FFC62828"
                                        Foreground="White"
                                        IsEnabled="{x:Bind ViewModel.CanWipeDatabase, Mode=OneWay}"
                                        Click="WipeDatabaseButton_Click" />
                            </StackPanel>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- OPERATION LOG -->
                <ctk:SettingsExpander Header="Operation Log"
                                      Description="{x:Bind ViewModel.OperationLogDescription, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.HasProgressLines, Mode=OneWay}">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ListView ItemsSource="{x:Bind ViewModel.ProgressLines, Mode=OneWay}"
                                      MinHeight="80" MaxHeight="200"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}"
                                                   FontFamily="Consolas"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- APPLIED MIGRATIONS -->
                <ctk:SettingsExpander Header="Update History"
                                      Description="Recent update attempts recorded by the admin app">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE930;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ListView ItemsSource="{x:Bind ViewModel.AppliedMigrations, Mode=OneWay}"
                                      MinHeight="40" MaxHeight="400"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="mig:AppliedMigration">
                                                                                <Grid ColumnDefinitions="2*,*,Auto,Auto" ColumnSpacing="12"
                                              Padding="0,4,0,4">
                                            <TextBlock Grid.Column="0"
                                                                                                             Text="{x:Bind Script}"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                                                             VerticalAlignment="Center"
                                                                                                             TextWrapping="WrapWholeWords" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Description}"
                                                       Style="{ThemeResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind AppliedAt}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind ExecutionMs}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

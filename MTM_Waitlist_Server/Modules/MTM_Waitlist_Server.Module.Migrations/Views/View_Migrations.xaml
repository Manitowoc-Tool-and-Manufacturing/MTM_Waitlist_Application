<Page
    x:Class="MTM_Waitlist_Server.Module.Migrations.Views.View_Migrations"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:mig="using:MTM_Waitlist_Server.Core.Models.Migration"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Margin="24,16,24,16" RowDefinitions="Auto,Auto,*" RowSpacing="8">

        <!-- Top toolbar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="Database Migrations" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Apply versioned schema migrations and re-run stored procedures."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="8">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="20" Height="20"
                              Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <Button Content="Refresh" MinHeight="36"
                        Command="{x:Bind ViewModel.LoadCommand, Mode=OneWay}" />
                <Button Content="Apply Migrations" MinHeight="36"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ApplyMigrationsCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Status bar — spans full width, shown only when there is a message -->
        <InfoBar Grid.Row="1"
                 Title="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 IsClosable="False"
                 Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

        <!-- Body -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="4" HorizontalAlignment="Stretch">

                <!-- SCHEMA VERSIONS TABLE WARNING -->
                <InfoBar Title="Schema Versions Table Missing"
                         Message="The schema_versions tracking table does not exist. Apply migrations to create it."
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.IsSchemaVersionsTableMissing, Mode=OneWay}"
                         IsClosable="False" />

                <!-- PENDING MIGRATIONS -->
                <ctk:SettingsExpander Header="Pending Migrations"
                                      Description="Migration scripts that have not yet been applied">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8A9;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <Button Content="Apply All" MinHeight="36"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ApplyMigrationsCommand, Mode=OneWay}" />
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ListView ItemsSource="{x:Bind ViewModel.PendingMigrations, Mode=OneWay}"
                                      MinHeight="40" MaxHeight="300"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="mig:PendingMigration">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                                              Padding="0,4,0,4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Version}"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Description}"
                                                       Style="{ThemeResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Content="Preview SQL"
                                                    MinHeight="32"
                                                    Tag="{x:Bind}"
                                                    Click="PreviewButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- SQL PREVIEW -->
                <ctk:SettingsExpander Header="SQL Preview"
                                      Description="SQL content of the selected pending migration">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ScrollViewer MaxHeight="300" HorizontalScrollMode="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ViewModel.SqlPreview, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- IDEMPOTENT OBJECTS -->
                <ctk:SettingsExpander Header="Re-run Idempotent Objects"
                                      Description="Re-apply stored procedures, triggers, and indexes without version tracking">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard Header="Re-run All Idempotent Objects"
                                          Description="Re-applies all stored procedures, triggers, and indexes from the database folder">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE72C;" />
                            </ctk:SettingsCard.HeaderIcon>
                            <Button Content="Re-run" MinHeight="36"
                                    Command="{x:Bind ViewModel.RerunIdempotentObjectsCommand, Mode=OneWay}" />
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- DANGER ZONE -->
                <ctk:SettingsExpander Header="Danger Zone"
                                      Description="Irreversible recovery actions for a broken or unrecoverable database state">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard Header="Wipe Database"
                                          Description="Drops the entire configured database, recreates it empty, and re-enables first-run setup.">
                            <ctk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE74D;" Foreground="#FFC62828" />
                            </ctk:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="8">
                                <TextBlock Text="This permanently deletes every table, row, procedure, trigger, and migration record in the configured database."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource BodyTextBlockStyle}" />
                                <Button Content="Wipe Database"
                                        MinHeight="36"
                                        Background="#FFC62828"
                                        Foreground="White"
                                        IsEnabled="{x:Bind ViewModel.CanWipeDatabase, Mode=OneWay}"
                                        Click="WipeDatabaseButton_Click" />
                            </StackPanel>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- OPERATION LOG -->
                <ctk:SettingsExpander Header="Operation Log"
                                      Description="{x:Bind ViewModel.OperationLogDescription, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.HasProgressLines, Mode=OneWay}">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ListView ItemsSource="{x:Bind ViewModel.ProgressLines, Mode=OneWay}"
                                      MinHeight="80" MaxHeight="200"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}"
                                                   FontFamily="Consolas"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <!-- APPLIED MIGRATIONS -->
                <ctk:SettingsExpander Header="Applied Migrations"
                                      Description="Migration versions that have already been run against this database">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE930;" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard>
                            <ListView ItemsSource="{x:Bind ViewModel.AppliedMigrations, Mode=OneWay}"
                                      MinHeight="40" MaxHeight="400"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="mig:AppliedMigration">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                                              Padding="0,4,0,4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Version}"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Description}"
                                                       Style="{ThemeResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind AppliedAt}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind ExecutionMs}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

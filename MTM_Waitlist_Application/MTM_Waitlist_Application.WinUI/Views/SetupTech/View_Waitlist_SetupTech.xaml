<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist_Application.WinUI.Views.SetupTech.View_Waitlist_SetupTech"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Waitlist_Application.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Core.Models.InforVisual"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="20">
            <TextBlock
                Grid.Row="0"
                Text="Setup Technician - New Job Setup"
                Style="{ThemeResource TitleLargeTextBlockStyle}" />

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <Border Background="#1565C0" Padding="8,4" CornerRadius="16">
                    <TextBlock Text="1" Foreground="White" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="1" Text="Workstation" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" Foreground="#9E9E9E" />
                <Border Grid.Column="3" Background="#BBBBBB" Padding="8,4" CornerRadius="16">
                    <TextBlock Text="2" Foreground="White" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="4" Text="Work Order" VerticalAlignment="Center" Foreground="#999999" />
                <TextBlock Grid.Column="5" Text="→" VerticalAlignment="Center" Foreground="#9E9E9E" />
                <TextBlock Grid.Column="6" Text="Validate + Dunnage" VerticalAlignment="Center" Foreground="#999999" />
            </Grid>

            <Border
                Grid.Row="2"
                Padding="20"
                Background="#FFF3E0"
                BorderBrush="#E65100"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.ShowUnauthorizedState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Access Required" FontWeight="SemiBold" FontSize="18" Foreground="#BF360C" />
                    <TextBlock Text="{x:Bind ViewModel.AccessDeniedMessage, Mode=OneWay}" Foreground="#BF360C" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="3*,16,2*" Visibility="{x:Bind ViewModel.IsWorkstationStep, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="Select Workstation" FontWeight="SemiBold" FontSize="14" />

                    <Border Grid.Row="1" Padding="10,6" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" PlaceholderText="Search workstation" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" BorderThickness="0" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="Search" VerticalAlignment="Center" Foreground="#666666" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                        <ListView ItemsSource="{x:Bind ViewModel.AvailableWorkcenters, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedWorkcenter, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_VisualWorkcenter">
                                    <Grid Padding="14,12" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="{x:Bind WorkcenterId, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind Description, Mode=OneWay}" Foreground="#777777" FontSize="11" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Button Grid.Row="3"
                            Height="44"
                            Background="#1565C0"
                            Command="{x:Bind ViewModel.ContinueToWorkOrderCommand}"
                            IsEnabled="{x:Bind ViewModel.CanContinueToWorkOrder, Mode=OneWay}"
                            Content="Continue to Work Order"
                            Foreground="White" />
                </Grid>

                <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock Text="Currently Active" FontWeight="SemiBold" FontSize="14" />
                    <Border Grid.Row="1"
                            Padding="16"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind ViewModel.HasCurrentActiveJob, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ACTIVE JOB" FontWeight="SemiBold" FontSize="11" Foreground="#1565C0" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Text="Work Order:" Foreground="#777777" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentActiveJob.WorkOrderId, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="Sequence:" Foreground="#777777" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CurrentActiveJob.SequenceNo, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Text="Part:" Foreground="#777777" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.CurrentActiveJob.PartId, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Text="Since:" Foreground="#777777" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.CurrentActiveJob.ActiveSince, Mode=OneWay}" />
                            </Grid>
                            <Border Padding="10" Background="#FFF3E0" BorderBrush="#E65100" BorderThickness="1" CornerRadius="6">
                                <TextBlock Text="Continuing will archive the current active job into workstation history." TextWrapping="Wrap" Foreground="#BF360C" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="3*,16,2*" Visibility="{x:Bind ViewModel.IsWorkOrderStep, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
                    <Border Padding="10,6" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="20" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Workstation:" Foreground="#555555" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedWorkcenter.WorkcenterId, Mode=OneWay}" Foreground="#1565C0" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="Scan Work Order Barcode" FontWeight="SemiBold" FontSize="14" />
                    <Border Grid.Row="2" Padding="12,8" Background="White" BorderBrush="#1565C0" BorderThickness="2" CornerRadius="8">
                        <TextBox PlaceholderText="WO-123456" Text="{x:Bind ViewModel.WorkOrderInput, Mode=TwoWay}" BorderThickness="0" />
                    </Border>
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Content="Back"
                                Width="120"
                                Background="#EEEEEE"
                                Command="{x:Bind ViewModel.BackToWorkstationCommand}"
                                Foreground="#333333" />
                        <Button Grid.Column="1"
                                Content="Look Up Work Order"
                                Background="#1565C0"
                                Command="{x:Bind ViewModel.LookupWorkOrderCommand}"
                                IsEnabled="{x:Bind ViewModel.CanLookupWorkOrder, Mode=OneWay}"
                                Foreground="White" />
                    </Grid>

                    <Border Grid.Row="4" Padding="16" Background="White" BorderBrush="#388E3C" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="INFOR VISUAL - LIVE DATA" Foreground="#388E3C" FontWeight="SemiBold" FontSize="10" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="Work Order:" Foreground="#777777" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkOrderHeader.WorkOrderId, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="Part:" Foreground="#777777" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.WorkOrderHeader.PartId, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Text="Status:" Foreground="#777777" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.WorkOrderHeader.WorkOrderStatus, Mode=OneWay}" />
                            </Grid>

                            <TextBlock Margin="0,8,0,0" Text="Select Sequence" FontWeight="SemiBold" FontSize="14" />
                            <ListView ItemsSource="{x:Bind ViewModel.AvailableSequences, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedSequence, Mode=TwoWay}"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_VisualWorkOrderSequence">
                                        <Grid Padding="14,12" RowDefinitions="Auto,Auto">
                                            <TextBlock Text="{x:Bind SequenceNo, Mode=OneWay}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1" Text="{x:Bind WorkcenterDescription, Mode=OneWay}" Foreground="#777777" FontSize="11" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="5"
                            Height="44"
                            Background="#1565C0"
                            Command="{x:Bind ViewModel.ContinueToValidationCommand}"
                            IsEnabled="{x:Bind ViewModel.CanContinueToValidation, Mode=OneWay}"
                            Content="Continue to Validation"
                            Foreground="White" />
                </Grid>

                <Border Grid.Column="2" Padding="12" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Tips" FontWeight="SemiBold" FontSize="12" Foreground="#444444" />
                        <TextBlock Text="Scan the physical job traveler barcode when available." FontSize="11" Foreground="#666666" TextWrapping="Wrap" />
                        <TextBlock Text="If the workcenter does not match exactly, all returned sequences are shown." FontSize="11" Foreground="#666666" TextWrapping="Wrap" />
                        <TextBlock Text="Only open or released work orders should be used for new setup." FontSize="11" Foreground="#666666" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="#1565C0" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" FontSize="11" Foreground="#B42318" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
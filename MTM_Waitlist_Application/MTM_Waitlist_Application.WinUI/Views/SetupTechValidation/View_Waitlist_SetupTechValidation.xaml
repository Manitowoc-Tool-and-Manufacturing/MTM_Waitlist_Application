<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist_Application.WinUI.Views.SetupTechValidation.View_Waitlist_SetupTechValidation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Waitlist_Application.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Core.Models.SetupTech"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24,16" RowDefinitions="Auto,Auto,*" RowSpacing="20">
            <TextBlock Grid.Row="0" Text="Setup Technician - Validate Job" Style="{ThemeResource TitleLargeTextBlockStyle}" />

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="✓" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Workstation" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="→" Foreground="#9E9E9E" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="✓" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="Work Order" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="→" Foreground="#9E9E9E" VerticalAlignment="Center" />
                <Border Grid.Column="6" Background="#1565C0" Padding="8,4" CornerRadius="16">
                    <TextBlock Text="3" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,16,*">
                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                    <TextBlock Text="Confirm Job Details" FontWeight="SemiBold" FontSize="14" />
                    <Border Grid.Row="1" Padding="20" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Text="Workstation" Foreground="#777777" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkcenterId, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="Work Order" Foreground="#777777" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.WorkOrderHeader.WorkOrderId, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Text="Sequence" Foreground="#777777" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedSequence.SequenceNo, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Text="Part Number" Foreground="#777777" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.WorkOrderHeader.PartId, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Text="Part Type" Foreground="#777777" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.WorkOrderHeader.PartType, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Padding="12" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="Change Work Order if anything looks incorrect before moving to dunnage assignment." Foreground="#1565C0" TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,10,*">
                        <Button Content="Change Work Order" Width="160" Height="44" Background="#EEEEEE" Command="{x:Bind ViewModel.ChangeWorkOrderCommand}" Foreground="#333333" />
                        <Button Grid.Column="2" Content="Approve and Continue" Height="44" Background="#388E3C" Command="{x:Bind ViewModel.ApproveCommand}" Foreground="White" />
                    </Grid>
                </Grid>

                <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock Text="Subordinate Parts" FontWeight="SemiBold" FontSize="14" />
                    <Border Grid.Row="1" Padding="16" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                        <ListView ItemsSource="{x:Bind ViewModel.SubordinateParts, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Model_SetupTech_SubordinatePart">
                                    <Grid Padding="0,8" ColumnDefinitions="*,60,80">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind SubPartId, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind SubPartDesc, Mode=OneWay}" Foreground="#555555" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind RequiredQty, Mode=OneWay}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind QtyOnHand, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1565C0" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
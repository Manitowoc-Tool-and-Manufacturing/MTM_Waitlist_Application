<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist_Application.WinUI.Views.SetupTechConfirmation.View_Waitlist_SetupTechConfirmation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Waitlist_Application.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Core.Models.SetupTech"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24,16" RowDefinitions="Auto,Auto,*" RowSpacing="20">
            <TextBlock Grid.Row="0" Text="Setup Technician - Complete" Style="{ThemeResource TitleLargeTextBlockStyle}" />

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="✓" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Workstation" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="→" Foreground="#9E9E9E" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="✓" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="Work Order" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="→" Foreground="#9E9E9E" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="✓" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="7" Text="Validate" Foreground="#388E3C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="8" Text="✓ Dunnage" Foreground="#388E3C" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2" Padding="36,30" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="20">
                    <Border Padding="20,14" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
                            <Border Background="#388E3C" Padding="10,6" CornerRadius="18">
                                <TextBlock Text="✓" Foreground="White" FontWeight="SemiBold" FontSize="18" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Active Job Saved" Foreground="#1B5E20" FontWeight="SemiBold" FontSize="18" />
                                <TextBlock Text="{x:Bind ViewModel.WorkcenterId, Mode=OneWay}" Foreground="#2E7D32" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,24,*" ColumnSpacing="24">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <Border Padding="14,10" Background="#F9F9F9" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="6">
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="Workstation" Foreground="#777777" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkcenterId, Mode=OneWay}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <Border Padding="14,10" Background="#F9F9F9" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="6">
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="Work Order" Foreground="#777777" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveJob.WorkOrderId, Mode=OneWay}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <Border Padding="14,10" Background="#F9F9F9" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="6">
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="Sequence" Foreground="#777777" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveJob.SequenceNo, Mode=OneWay}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <Border Padding="14,10" Background="#F9F9F9" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="6">
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="Part" Foreground="#777777" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveJob.PartId, Mode=OneWay}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <Border Padding="14,10" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="6">
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="Saved By" Foreground="#777777" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SavedByDisplayName, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="10">
                            <TextBlock Text="SUBORDINATE PARTS" FontWeight="SemiBold" FontSize="12" Foreground="#555555" />
                            <ListView Height="180" ItemsSource="{x:Bind ViewModel.SubordinateParts, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_SetupTech_SubordinatePart">
                                        <Grid Padding="0,4" ColumnDefinitions="*,60,60">
                                            <TextBlock Text="{x:Bind SubPartId, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind RequiredQty, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#777777" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind QtyOnHand, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1565C0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="DUNNAGE ASSIGNED" FontWeight="SemiBold" FontSize="12" Foreground="#555555" />
                            <ListView Height="140" ItemsSource="{x:Bind ViewModel.DunnageAssignments, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_SetupTech_DunnageAssignment">
                                        <StackPanel Padding="0,4">
                                            <TextBlock Text="{x:Bind DunnagePartName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{x:Bind DunnageTypeName, Mode=OneWay}" FontSize="11" Foreground="#777777" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Previous active job for this workstation was archived to history."
                               FontSize="11"
                               Foreground="#777777"
                               Visibility="{x:Bind ViewModel.HadArchivedExistingJob, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Grid Grid.Row="3" ColumnDefinitions="*,12,*">
                        <Button Grid.Column="0" Height="38" Background="#EEEEEE" Command="{x:Bind ViewModel.StartOverCommand}" Content="New Setup" Foreground="#333333" />
                        <Button Grid.Column="2" Height="38" Background="#1565C0" Command="{x:Bind ViewModel.GoToDashboardCommand}" Content="Go to Dashboard" Foreground="White" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
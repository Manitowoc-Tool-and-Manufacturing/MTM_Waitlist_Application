<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist_Application.WinUI.Views.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MTM_Waitlist_Application.WinUI.Views.Dashboard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="20">

        <!-- ── Page header ─────────────────────────────────────────── -->
        <TextBlock
            Grid.Row="0"
            Text="MTM Waitlist — Dashboard"
            Style="{ThemeResource TitleLargeTextBlockStyle}" />

        <!-- ── Summary cards row ───────────────────────────────────── -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="12">

            <!-- Total Entries -->
            <Border
                Grid.Column="0"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Total Entries"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="—"
                        Style="{ThemeResource TitleLargeTextBlockStyle}" />
                </StackPanel>
            </Border>

            <!-- Waiting -->
            <Border
                Grid.Column="1"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Waiting"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="—"
                        Style="{ThemeResource TitleLargeTextBlockStyle}" />
                </StackPanel>
            </Border>

            <!-- In Progress -->
            <Border
                Grid.Column="2"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="In Progress"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="—"
                        Style="{ThemeResource TitleLargeTextBlockStyle}" />
                </StackPanel>
            </Border>

            <!-- Completed Today -->
            <Border
                Grid.Column="3"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Completed Today"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="—"
                        Style="{ThemeResource TitleLargeTextBlockStyle}" />
                </StackPanel>
            </Border>

        </Grid>

        <!-- ── Waitlist entries area (placeholder) ──────────────────── -->
        <Border
            Grid.Row="2"
            Padding="24"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Waitlist entries will appear here once the service layer is connected."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ── Status bar ───────────────────────────────────────────── -->
        <TextBlock
            Grid.Row="3"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

    </Grid>
</Page>

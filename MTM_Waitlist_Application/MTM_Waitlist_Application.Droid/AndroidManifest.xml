<?xml version="1.0" encoding="utf-8"?>
<manifest
  xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.companyname.mtm_waitlist_application"
  android:versionCode="1"
  android:versionName="1.0"
>
  <!-- networkSecurityConfig enforces HTTPS in Release while allowing cleartext in Debug only.
	     Do NOT use android:usesCleartextTraffic="false" directly — that blocks all HTTP in both
	     Debug and Release, which breaks local-dev API traffic on the emulator. -->
  <application
    android:allowBackup="true"
    android:icon="@mipmap/appicon"
    android:roundIcon="@mipmap/appicon_round"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:networkSecurityConfig="@xml/network_security_config"
  ></application>
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>

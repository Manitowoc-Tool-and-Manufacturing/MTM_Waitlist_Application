<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Feature.Auth.Views.Login.View_Auth_Login"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Feature.Auth.ViewModels.Login"
    Title="Sign In"
    x:DataType="vm:ViewModel_Auth_Login">

    <ScrollView>
        <VerticalStackLayout Padding="20,28" Spacing="16">
            <Label
                FontAttributes="Bold"
                FontSize="26"
                HorizontalTextAlignment="Center"
                Text="MTM Waitlist" />
            <Label
                FontSize="14"
                HorizontalTextAlignment="Center"
                Text="Sign in with your Windows username and password or floor PIN."
                TextColor="{AppThemeBinding Light=#666666,
                                            Dark=#B8B8B8}" />

            <Border
                Padding="12"
                BackgroundColor="#FFF4CE"
                Stroke="#F2C811"
                StrokeShape="RoundRectangle 8"
                IsVisible="{Binding HasStatusMessage, Mode=OneWay}">
                <Label
                    FontSize="13"
                    Text="{Binding StatusMessage, Mode=OneWay}"
                    TextColor="#5F4700" />
            </Border>

            <Button
                Command="{Binding RetryStartupCommand}"
                HeightRequest="52"
                IsVisible="{Binding CanRetryStartup, Mode=OneWay}"
                Text="Try Again" />

            <VerticalStackLayout
                IsVisible="{Binding IsSharedWorkstation, Mode=OneWay}"
                Spacing="8">
                <Label
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="Windows Username" />
                <Entry
                    ClearButtonVisibility="WhileEditing"
                    Placeholder="DOMAIN\\username"
                    Text="{Binding Username, Mode=TwoWay}" />
            </VerticalStackLayout>

            <VerticalStackLayout
                IsVisible="{Binding IsSharedWorkstation, Mode=OneWay}"
                Spacing="8">
                <Label
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="Password / PIN" />
                <Entry
                    IsPassword="True"
                    Placeholder="Enter your password or PIN"
                    Text="{Binding Password, Mode=TwoWay}" />
            </VerticalStackLayout>

            <Label
                FontSize="12"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsSharedWorkstation, Mode=OneWay}"
                Text="{Binding ErrorMessage, Mode=OneWay}"
                TextColor="#B42318" />

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button
                    Grid.Column="0"
                    Command="{Binding LoginCommand}"
                    HeightRequest="52"
                    IsVisible="{Binding IsSharedWorkstation, Mode=OneWay}"
                    Text="Sign In" />
                <Button
                    Grid.Column="1"
                    Command="{Binding CopyErrorCommand}"
                    HeightRequest="52"
                    IsVisible="{Binding HasStatusMessage, Mode=OneWay}"
                    Text="Copy Error" />
                <Button
                    Grid.Column="2"
                    Command="{Binding ClearPasswordCommand}"
                    HeightRequest="52"
                    IsVisible="{Binding IsSharedWorkstation, Mode=OneWay}"
                    Text="Clear" />
            </Grid>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy, Mode=OneWay}"
                IsVisible="{Binding IsBusy, Mode=OneWay}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

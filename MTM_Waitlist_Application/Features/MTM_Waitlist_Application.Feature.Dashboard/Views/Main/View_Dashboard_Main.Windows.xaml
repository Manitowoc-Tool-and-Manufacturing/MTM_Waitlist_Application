<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MTM_Waitlist_Application.Feature.Dashboard.Views.Main.View_Dashboard_Main"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MTM_Waitlist_Application.Feature.Dashboard.ViewModels.Main"
    Title="Dashboard"
    x:DataType="vm:ViewModel_Dashboard_Main">

    <Grid Padding="24,16" RowDefinitions="Auto,Auto,*,Auto">

        <!--  ── Page header ────────────────────────────────────────────  -->
        <Label
            Grid.Row="0"
            Margin="0,0,0,20"
            FontAttributes="Bold"
            FontSize="26"
            Text="MTM Waitlist — Dashboard" />

        <!--  ── Summary cards row ──────────────────────────────────────  -->
        <Grid
            Grid.Row="1"
            Margin="0,0,0,20"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="12">

            <Border
                Grid.Column="0"
                Padding="16"
                StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="11"
                        Text="Total Entries"
                        TextColor="{AppThemeBinding Light=#555555,
                                                    Dark=#AAAAAA}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="—" />
                </VerticalStackLayout>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="11"
                        Text="Waiting"
                        TextColor="{AppThemeBinding Light=#555555,
                                                    Dark=#AAAAAA}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="—" />
                </VerticalStackLayout>
            </Border>

            <Border
                Grid.Column="2"
                Padding="16"
                StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="11"
                        Text="In Progress"
                        TextColor="{AppThemeBinding Light=#555555,
                                                    Dark=#AAAAAA}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="—" />
                </VerticalStackLayout>
            </Border>

            <Border
                Grid.Column="3"
                Padding="16"
                StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="11"
                        Text="Completed Today"
                        TextColor="{AppThemeBinding Light=#555555,
                                                    Dark=#AAAAAA}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="—" />
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!--  ── Waitlist entries area (placeholder) ────────────────────  -->
        <Border
            Grid.Row="2"
            Padding="24"
            StrokeShape="RoundRectangle 8">
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="10"
                VerticalOptions="Center">
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy, Mode=OneWay}"
                    IsVisible="{Binding IsBusy, Mode=OneWay}" />
                <Label
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    Text="Waitlist entries will appear here."
                    TextColor="{AppThemeBinding Light=#555555,
                                                Dark=#AAAAAA}" />
                <Label
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Implement Phases 1–3 (Core → Data → Services) to load live data."
                    TextColor="{AppThemeBinding Light=#888888,
                                                Dark=#777777}" />
            </VerticalStackLayout>
        </Border>

        <!--  ── Status bar ──────────────────────────────────────────────  -->
        <Label
            Grid.Row="3"
            Margin="0,8,0,0"
            FontSize="11"
            HorizontalTextAlignment="Start"
            Text="{Binding StatusMessage, Mode=OneWay}"
            TextColor="{AppThemeBinding Light=#888888,
                                        Dark=#777777}" />

    </Grid>

</ContentPage>

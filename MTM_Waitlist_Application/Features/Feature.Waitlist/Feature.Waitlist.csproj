    <None Include="Views\SetupTech\View_Waitlist_SetupTech.Android.xaml">
      <SubType>Designer</SubType>
      <Visible>true</Visible>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">

<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MTM_Waitlist_Application.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:Feature.Dashboard.Views.Main;assembly=Feature.Dashboard"
    Title="MTM Waitlist"
    FlyoutBehavior="{OnPlatform WinUI=Locked,
                                Android=Flyout}">

    <!--  ── Flyout header (shown on Android hamburger panel and Windows sidebar) ──  -->
    <Shell.FlyoutHeader>
        <Grid
            Padding="16,0"
            BackgroundColor="{AppThemeBinding Light=#1565C0,
                                              Dark=#0D47A1}"
            HeightRequest="80">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="MTM Waitlist"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <!--  ── Navigation items ──────────────────────────────────────────────────────  -->
    <ShellContent
        x:Name="DashboardContent"
        Title="Dashboard"
        Route="Dashboard" />

    <!--
        Add further FlyoutItems here as feature pages are built.
        Example:
        <FlyoutItem Title="Waitlist">
            <ShellContent
                Title="Waitlist"
                ContentTemplate="{DataTemplate waitlist:View_Waitlist_Entry}"
                Route="WaitlistEntry" />
        </FlyoutItem>
    -->

</Shell>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="400"
    Background="#F0F2F5" x:Class="App7.MainWindow" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:DesignWidth="430" d:DesignHeight="932" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Page title ──────────────────────────────────────────── -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="18"
            FontWeight="Bold"
            Text="New Job Setup" />

        <!-- ── Progress bar: step 4 of 4 — all segments active ─────── -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="6" Background="#388E3C" CornerRadius="3" />
            <Border Grid.Column="2" Height="6" Background="#388E3C" CornerRadius="3" />
            <Border Grid.Column="4" Height="6" Background="#388E3C" CornerRadius="3" />
            <Border Grid.Column="6" Height="6" Background="#1565C0" CornerRadius="3" />
        </Grid>
        <TextBlock
            Grid.Row="2"
            Margin="0,2,0,12"
            FontSize="11"
            Foreground="#777777"
            Text="Step 4 of 4 — Dunnage" />

        <!-- ── Body ─────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="3" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Current assignment section -->
                <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="Bold" Text="Current Assignment" />
                <TextBlock Margin="0,0,0,10" FontSize="11" Foreground="#555555" Text="WO-123456 / Seq 20  ·  Cached from previous run" />

                <!-- Assigned item 1 -->
                <Border Margin="0,0,0,8" Padding="14,10" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="Bold" Text="Skid Pallet — Wood" />
                            <TextBlock FontSize="11" Foreground="#555555" Text="Skids" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="40" Height="40" Background="#FFEBEE" Content="✕" FontSize="12" Foreground="#C62828" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Assigned item 2 -->
                <Border Margin="0,0,0,8" Padding="14,10" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="Bold" Text="Gaylord Box — Standard" />
                            <TextBlock FontSize="11" Foreground="#555555" Text="Containers" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="40" Height="40" Background="#FFEBEE" Content="✕" FontSize="12" Foreground="#C62828" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Assigned item 3 -->
                <Border Margin="0,0,0,16" Padding="14,10" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="Bold" Text="Cardboard Slip Sheet" />
                            <TextBlock FontSize="11" Foreground="#555555" Text="Flat Stock" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="40" Height="40" Background="#FFEBEE" Content="✕" FontSize="12" Foreground="#C62828" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Add dunnage section -->
                <TextBlock Margin="0,0,0,10" FontSize="14" FontWeight="Bold" Text="Add Dunnage" />

                <!-- Category buttons -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Active category -->
                    <Border Grid.Row="0" Grid.Column="0" Height="44" Background="#1565C0" BorderBrush="#1565C0" BorderThickness="1" CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="Containers" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Height="44" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#555555" Text="Skids" />
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Height="44" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#555555" Text="Coils" />
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Height="44" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#555555" Text="Flat Stock" />
                    </Border>
                </Grid>

                <!-- Catalog items for active category -->
                <Border Margin="0,0,0,6" Padding="14,12" Background="#E3F2FD" BorderBrush="#1565C0" BorderThickness="2" CornerRadius="8">
                    <TextBlock FontSize="14" FontWeight="Bold" Text="Gaylord Box — Standard" />
                </Border>
                <Border Margin="0,0,0,6" Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <TextBlock FontSize="14" Text="Gaylord Box — Half Height" />
                </Border>
                <Border Margin="0,0,0,6" Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <TextBlock FontSize="14" Text="Parts Tote — Large" />
                </Border>
                <Border Margin="0,0,0,6" Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <TextBlock FontSize="14" Text="Parts Tote — Small" />
                </Border>

                <!-- Quantity + add row -->
                <Button
                    Margin="0,10,0,0"
                    Height="52"
                    Background="#1565C0"
                    Content="+ Add to Assignment"
                    FontSize="14"
                    Foreground="White" />

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer: save ──────────────────────────────────────── -->
        <Button
            Grid.Row="4"
            Height="52"
            Background="#388E3C"
            Content="✔  Save &amp; Complete Setup"
            FontSize="15"
            FontWeight="Bold"
            Foreground="White" />

    </Grid>

</Window>

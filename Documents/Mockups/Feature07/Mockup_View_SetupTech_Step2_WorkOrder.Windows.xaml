<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F0F2F5" x:Class="App4.MainWindow" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="768">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Page title ──────────────────────────────────────────── -->

        <!-- ── Step indicator ──────────────────────────────────────── -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,14"
            Padding="16,12"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                <!-- Step 1 — Completed -->
                <Border Width="30" Height="30" Background="#388E3C" CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="✔" />
                </Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#388E3C" Text="Workstation" />
                <Rectangle Width="36" Height="2" Margin="8,0" VerticalAlignment="Center" Fill="#388E3C" />

                <!-- Step 2 — Active -->
                <Border Width="30" Height="30" Background="#1565C0" CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="2" />
                </Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#1565C0" Text="Work Order" />
                <Rectangle Width="36" Height="2" Margin="8,0" VerticalAlignment="Center" Fill="#CCCCCC" />

                <!-- Step 3 — Pending -->
                <Border Width="30" Height="30" Background="#BBBBBB" CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="3" />
                </Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#999999" Text="Validate" />
                <Rectangle Width="36" Height="2" Margin="8,0" VerticalAlignment="Center" Fill="#CCCCCC" />

                <!-- Step 4 — Pending -->
                <Border Width="30" Height="30" Background="#BBBBBB" CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="4" />
                </Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#999999" Text="Dunnage" />

            </StackPanel>
        </Border>

        <!-- ── Body: two columns ─────────────────────────────────── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: barcode + sequence selector -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

 

                <TextBlock
                    Grid.Row="5"
                    Margin="0,0,0,8"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Select Sequence" />

                <!-- Sequence list -->
                <ScrollViewer Grid.Row="6" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Selected sequence -->
                        <Border
                            Margin="0,0,0,6"
                            Padding="14,12"
                            Background="#E3F2FD"
                            BorderBrush="#1565C0"
                            BorderThickness="2"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="14" FontWeight="Bold" Text="Seq 20" />
                                    <TextBlock FontSize="11" Foreground="#555555" Text="PRESS-07 · Stamping Operation" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Text="✔" />
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,6" Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Text="Seq 30" />
                                <TextBlock FontSize="11" Foreground="#777777" Text="PRESS-07 · Secondary Op" />
                            </StackPanel>
                        </Border>

                        <Border Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Text="Seq 40" />
                                <TextBlock FontSize="11" Foreground="#777777" Text="OUTSIDE SVC · Vendor finish" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer nav -->
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="100"
                        Height="44"
                        Background="#EEEEEE"
                        Content="← Back"
                        FontSize="13"
                        Foreground="#333333" />
                    <Button
                        Grid.Column="2"
                        Height="44"
                        Background="#1565C0"
                        Content="Continue to Validation  →"
                        FontSize="14"
                        Foreground="White" />
                </Grid>

            </Grid>

            <!-- Right: retrieved WO data + tips -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Work Order Info" />

                <!-- Retrieved data card -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="16"
                    Background="White"
                    BorderBrush="#388E3C"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" FontSize="10" FontWeight="Bold" Foreground="#388E3C" Text="INFOR VISUAL — LIVE DATA" />
                        <Rectangle Height="1" Fill="#E8E8E8" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Foreground="#777777" Text="Work Order:" />
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="12" FontWeight="Bold" Text="WO-123456" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" FontSize="12" Foreground="#777777" Text="Part:" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" FontSize="12" Text="98765-B" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" FontSize="12" Foreground="#777777" Text="Status:" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" FontSize="12" Text="Open" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tips panel -->
                <Border
                    Grid.Row="2"
                    Padding="12"
                    Background="#F3F3F3"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="Bold" Foreground="#444444" Text="Tips" />
                        <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="#666666" Text="• Scan the barcode on the physical job traveler." TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="#666666" Text="• The barcode contains both the Work Order and Sequence." TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="#666666" Text="• If no barcode is available, type the work order and choose a sequence from the list." TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#666666" Text="• Only Open / Released work orders are shown." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </Grid>

        </Grid>
        <Grid  Grid.Row="2" Margin="0,0,0,0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Orientation="Vertical" >
                               <!-- Context chip -->
 
                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Scan Work Order Barcode" />

                <!-- Barcode input (auto-focused for scanner wedge) -->
                <Border
                    Grid.Row="2"
                    Margin="0,0,0,6"
                    Padding="12,8"
                    Background="White"
                    BorderBrush="#1565C0"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            BorderThickness="0"
                            FontSize="16"
                            Text="WO-123456" />
                        <Border
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="10,6"
                            Background="#1565C0"
                            CornerRadius="6">
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="White" Text="Look Up" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="3"
                    Margin="0,0,0,12"
                    FontSize="11"
                    Foreground="#777777"
                    Text="Point a USB barcode scanner at the field above and scan the job traveler, or type the work order number manually."
                    TextWrapping="Wrap" />

                <Rectangle Grid.Row="4" Height="1" Fill="#E0E0E0" Margin="0,0,0,12" />
            </StackPanel>
            


        </Grid>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Text="Setup Technician — New Job Setup" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Border Grid.Row="0" Padding="10,6" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="20" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" Foreground="#555555" Text="Workstation: " />
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#1565C0" Text="PRESS-07" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</Window>

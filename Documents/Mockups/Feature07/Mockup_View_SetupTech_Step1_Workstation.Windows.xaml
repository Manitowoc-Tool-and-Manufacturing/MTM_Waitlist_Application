<?xml version="1.0" encoding="utf-8" ?>
<!--
    MOCKUP — Feature 07: Setup Technician Module
    Screen   : Step 1 — Select Workstation  (Windows / Kiosk layout)
    Platform : Windows — multi-column, data-dense
    Paste at  https://xaml.io/ to preview
    Static sample data — WPF / OpenSilver syntax
-->
<UserControl
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Page title ──────────────────────────────────────────── -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,14"
            FontSize="20"
            FontWeight="Bold"
            Text="Setup Technician — New Job Setup" />

        <!-- ── Step indicator ──────────────────────────────────────── -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,14"
            Padding="16,12"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                <!-- Step 1 — Active -->
                <Border
                    Width="30"
                    Height="30"
                    Background="#1565C0"
                    CornerRadius="15">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="1" />
                </Border>
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#1565C0"
                    Text="Workstation" />
                <Rectangle
                    Width="36"
                    Height="2"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Fill="#1565C0" />

                <!-- Step 2 — Pending -->
                <Border Width="30" Height="30" Background="#BBBBBB" CornerRadius="15">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="2" />
                </Border>
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#999999"
                    Text="Work Order" />
                <Rectangle Width="36" Height="2" Margin="8,0" VerticalAlignment="Center" Fill="#CCCCCC" />

                <!-- Step 3 — Pending -->
                <Border Width="30" Height="30" Background="#BBBBBB" CornerRadius="15">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="3" />
                </Border>
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#999999"
                    Text="Validate" />
                <Rectangle Width="36" Height="2" Margin="8,0" VerticalAlignment="Center" Fill="#CCCCCC" />

                <!-- Step 4 — Pending -->
                <Border Width="30" Height="30" Background="#BBBBBB" CornerRadius="15">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="4" />
                </Border>
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#999999"
                    Text="Dunnage" />

            </StackPanel>
        </Border>

        <!-- ── Body: two columns ─────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: workstation picker -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Select Workstation" />

                <!-- Search box -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,10"
                    Padding="10,6"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" BorderThickness="0" Text="PRESS" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="🔍" />
                    </Grid>
                </Border>

                <!-- Workcenter list -->
                <ScrollViewer Grid.Row="2" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Selected row -->
                        <Border
                            Margin="0,0,0,5"
                            Padding="14,12"
                            Background="#E3F2FD"
                            BorderBrush="#1565C0"
                            BorderThickness="2"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="15" FontWeight="Bold" Text="PRESS-07" />
                                    <TextBlock FontSize="11" Foreground="#555555" Text="Press Floor — Zone A" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#1565C0"
                                    Text="✔" />
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,5" Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="Bold" Text="PRESS-14" />
                                <TextBlock FontSize="11" Foreground="#777777" Text="Press Floor — Zone A" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,5" Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="Bold" Text="PRESS-22" />
                                <TextBlock FontSize="11" Foreground="#777777" Text="Press Floor — Zone B" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,5" Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="Bold" Text="PRESS-31" />
                                <TextBlock FontSize="11" Foreground="#777777" Text="Press Floor — Zone B" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,5" Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="Bold" Text="PRESS-45" />
                                <TextBlock FontSize="11" Foreground="#777777" Text="Press Floor — Zone C" />
                            </StackPanel>
                        </Border>

                        <Border Padding="14,12" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="Bold" Text="PRESS-52" />
                                <TextBlock FontSize="11" Foreground="#777777" Text="Press Floor — Zone C" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Button
                    Grid.Row="3"
                    Height="44"
                    Background="#1565C0"
                    Content="Continue to Work Order  →"
                    FontSize="14"
                    Foreground="White" />

            </Grid>

            <!-- Right: current active job at selected workstation -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Currently Active at PRESS-07" />

                <Border
                    Grid.Row="1"
                    Padding="16"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    VerticalAlignment="Top">
                    <StackPanel>

                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#1565C0"
                            Text="ACTIVE JOB" />
                        <Rectangle Height="1" Fill="#E8E8E8" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Foreground="#777777" Text="Work Order:" />
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="12" FontWeight="Bold" Text="WO-098765" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" FontSize="12" Foreground="#777777" Text="Sequence:" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" FontSize="12" Text="Seq 20" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" FontSize="12" Foreground="#777777" Text="Part:" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" FontSize="12" Text="12345-A" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" FontSize="12" Foreground="#777777" Text="Setup By:" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,8,0,0" FontSize="12" Text="jsmith" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" FontSize="12" Foreground="#777777" Text="Since:" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,8,0,0" FontSize="12" Text="6:42 AM today" />
                        </Grid>

                        <Rectangle Height="1" Fill="#E8E8E8" Margin="0,0,0,10" />

                        <Border
                            Padding="10"
                            Background="#FFF3E0"
                            BorderBrush="#E65100"
                            BorderThickness="1"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="11"
                                Foreground="#BF360C"
                                Text="⚠  Selecting PRESS-07 will archive the current active job to history."
                                TextWrapping="Wrap" />
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F0F2F5" x:Class="App6.MainWindow" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:DesignWidth="1360" d:DesignHeight="768" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Page title ──────────────────────────────────────────── -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,14"
            FontSize="20"
            FontWeight="Bold"
            Text="Setup Technician — New Job Setup" />

        <!-- ── Step indicator ──────────────────────────────────────── -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,14"
            Padding="16,12"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                <!-- Step 1 — Completed -->
                <Border Width="30" Height="30" Background="#388E3C" CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="✔" />
                </Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#388E3C" Text="Workstation" />
                <Rectangle Width="36" Height="2" Margin="8,0" VerticalAlignment="Center" Fill="#388E3C" />

                <!-- Step 2 — Completed -->
                <Border Width="30" Height="30" Background="#388E3C" CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="✔" />
                </Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#388E3C" Text="Work Order" />
                <Rectangle Width="36" Height="2" Margin="8,0" VerticalAlignment="Center" Fill="#388E3C" />

                <!-- Step 3 — Active -->
                <Border Width="30" Height="30" Background="#1565C0" CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="3" />
                </Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#1565C0" Text="Validate" />
                <Rectangle Width="36" Height="2" Margin="8,0" VerticalAlignment="Center" Fill="#CCCCCC" />

                <!-- Step 4 — Pending -->
                <Border Width="30" Height="30" Background="#BBBBBB" CornerRadius="15">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="4" />
                </Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#999999" Text="Dunnage" />

            </StackPanel>
        </Border>

        <!-- ── Body: two columns ─────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: job summary card -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Confirm Job Details" />

                <!-- Job summary card -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="20"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>

                        <TextBlock Margin="0,0,0,8" FontSize="10" FontWeight="Bold" Foreground="#1565C0" Text="INFOR VISUAL — RETRIEVED DATA" />
                        <Rectangle Height="1" Fill="#E8E8E8" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" Foreground="#777777" Text="Workstation" />
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13" FontWeight="Bold" Text="PRESS-07" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" FontSize="13" Foreground="#777777" Text="Work Order" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" FontSize="13" FontWeight="Bold" Text="WO-123456" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" FontSize="13" Foreground="#777777" Text="Sequence" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" FontSize="13" FontWeight="Bold" Text="Seq 919  —  Stamping Operation" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,12,0,0" FontSize="13" Foreground="#777777" Text="Part Number" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" FontSize="13" FontWeight="Bold" Text="98765-B" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,12,0,0" FontSize="13" Foreground="#777777" Text="Part Type" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" FontSize="13" Text="Finished Goods" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,12,0,0" FontSize="13" Foreground="#777777" Text="WO Status" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,12,0,0" FontSize="13" Text="Open" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Change link -->
                <Border
                    Grid.Row="2"
                    Margin="0,0,0,12"
                    Padding="12"
                    Background="#F3F3F3"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">
                    <TextBlock
                        FontSize="12"
                        Foreground="#1565C0"
                        Text="Something wrong? Click 'Change Work Order' below to go back and re-scan or enter a different work order or sequence."
                        TextWrapping="Wrap" />
                </Border>

                <!-- Footer nav -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="160"
                        Height="44"
                        Background="#EEEEEE"
                        Content="← Change Work Order"
                        FontSize="13"
                        Foreground="#333333" />
                    <Button
                        Grid.Column="2"
                        Height="44"
                        Background="#388E3C"
                        Content="✔  Approve &amp; Continue to Dunnage"
                        FontSize="14"
                        Foreground="White" />
                </Grid>

            </Grid>

            <!-- Right: subordinate parts list -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Subordinate Parts" />

                <Border
                    Grid.Row="1"
                    Padding="16"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8" Height="592">
                    <StackPanel>
                        <Rectangle Height="1" Fill="#E8E8E8" Margin="0,0,0,10" />

                        <!-- Column headers -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="11" FontWeight="Bold" Foreground="#999999" Text="PART" />
                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="#999999" Text="DESCRIPTION" />
                            <TextBlock Grid.Column="2" FontSize="11" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Right" Text="REQ QTY" />
                            <TextBlock Grid.Column="3" FontSize="11" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Right" Text="ON HAND" />
                        </Grid>
                        <Rectangle Height="1" Fill="#F0F0F0" Margin="0,0,0,6" />

                        <!-- Part rows -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="13" FontWeight="Bold" Text="COIL-4412" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#555555" Text="HR Coil Stock" />
                            <TextBlock Grid.Column="2" FontSize="13" HorizontalAlignment="Right" Text="1" />
                            <TextBlock Grid.Column="3" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#1565C0" Text="14" />
                        </Grid>
                        <Rectangle Height="1" Fill="#F5F5F5" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="13" FontWeight="Bold" Text="BLANK-221" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#555555" Text="Stamped Blank" />
                            <TextBlock Grid.Column="2" FontSize="13" HorizontalAlignment="Right" Text="500" />
                            <TextBlock Grid.Column="3" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#1565C0" Text="1,250" />
                        </Grid>
                        <Rectangle Height="1" Fill="#F5F5F5" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="13" FontWeight="Bold" Text="LUB-003" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#555555" Text="Press Lubricant" />
                            <TextBlock Grid.Column="2" FontSize="13" HorizontalAlignment="Right" Text="2" />
                            <TextBlock Grid.Column="3" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#1565C0" Text="8" />
                        </Grid>

                    </StackPanel>
                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>
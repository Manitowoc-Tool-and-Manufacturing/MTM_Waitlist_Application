<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="400"
    Background="#F0F2F5" x:Class="App3.MainWindow" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:DesignWidth="430" d:DesignHeight="932" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Page title ──────────────────────────────────────────── -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="18"
            FontWeight="Bold"
            Text="New Job Setup" />

        <!-- ── Progress bar: step 2 of 4 ──────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="6" Background="#388E3C" CornerRadius="3" />
            <Border Grid.Column="2" Height="6" Background="#1565C0" CornerRadius="3" />
            <Border Grid.Column="4" Height="6" Background="#CCCCCC" CornerRadius="3" />
            <Border Grid.Column="6" Height="6" Background="#CCCCCC" CornerRadius="3" />
        </Grid>
        <TextBlock
            Grid.Row="2"
            Margin="0,2,0,12"
            FontSize="11"
            Foreground="#777777"
            Text="Step 2 of 4 — Work Order" />

        <!-- ── Body ─────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="3" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Context chip -->
                <Border
                    Margin="0,0,0,12"
                    Padding="10,6"
                    Background="#E3F2FD"
                    BorderBrush="#90CAF9"
                    BorderThickness="1"
                    CornerRadius="20"
                    HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="#555555" Text="Workstation: " />
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#1565C0" Text="PRESS-07" />
                    </StackPanel>
                </Border>

                <!-- Barcode input -->
                <TextBlock Margin="0,0,0,6" FontSize="14" FontWeight="Bold" Text="Scan Work Order Barcode" />
                <Border
                    Margin="0,0,0,6"
                    Padding="12,8"
                    Background="White"
                    BorderBrush="#1565C0"
                    BorderThickness="2"
                    CornerRadius="8">
                    <TextBox BorderThickness="0" FontSize="16" Text="WO-123456" />
                </Border>
                <Button
                    Margin="0,0,0,6"
                    Height="48"
                    Background="#1565C0"
                    Content="Look Up Work Order"
                    FontSize="14"
                    Foreground="White" />

                <!-- Retrieved WO data -->
                <Border
                    Margin="0,0,0,16"
                    Padding="14"
                    Background="White"
                    BorderBrush="#388E3C"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" FontSize="10" FontWeight="Bold" Foreground="#388E3C" Text="INFOR VISUAL — LIVE DATA" />
                        <Rectangle Height="1" Fill="#E8E8E8" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" Foreground="#777777" Text="Work Order:" />
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="13" FontWeight="Bold" Text="WO-123456" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" FontSize="13" Foreground="#777777" Text="Part:" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" FontSize="13" Text="98765-B" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" FontSize="13" Foreground="#777777" Text="Status:" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" FontSize="13" Text="Open" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sequence selector -->
                <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="Bold" Text="Select Sequence" />

                <!-- Selected sequence -->
                <Border
                    Height="60"
                    Margin="0,0,0,8"
                    Padding="16,0"
                    Background="#E3F2FD"
                    BorderBrush="#1565C0"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Seq 20" />
                            <TextBlock FontSize="11" Foreground="#555555" Text="PRESS-07 · Stamping Operation" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#1565C0" Text="✔" />
                    </Grid>
                </Border>

                <Border Height="60" Margin="0,0,0,8" Padding="16,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold" Text="Seq 30" />
                        <TextBlock FontSize="11" Foreground="#777777" Text="PRESS-07 · Secondary Op" />
                    </StackPanel>
                </Border>

                <Border Height="60" Margin="0,0,0,8" Padding="16,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold" Text="Seq 40" />
                        <TextBlock FontSize="11" Foreground="#777777" Text="OUTSIDE SVC · Vendor finish" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer nav ─────────────────────────────────────────── -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Height="52" Background="#EEEEEE" Content="← Back" FontSize="14" Foreground="#333333" />
            <Button Grid.Column="2" Height="52" Background="#1565C0" Content="Continue →" FontSize="14" Foreground="White" />
        </Grid>

    </Grid>

</Window>

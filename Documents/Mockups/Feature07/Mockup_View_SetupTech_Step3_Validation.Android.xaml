<?xml version="1.0" encoding="utf-8" ?>
<!--
    MOCKUP — Feature 07: Setup Technician Module
    Screen   : Step 3 — Validate Work Order Data  (Android / companion layout)
    Platform : Android — single-column, large tap targets (min 48 px)
    Paste at  https://xaml.io/ to preview
    Static sample data — WPF / OpenSilver syntax
-->
<UserControl
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Width="400"
    Background="#F0F2F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Page title ──────────────────────────────────────────── -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="18"
            FontWeight="Bold"
            Text="New Job Setup" />

        <!-- ── Progress bar: step 3 of 4 ──────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="6" Background="#388E3C" CornerRadius="3" />
            <Border Grid.Column="2" Height="6" Background="#388E3C" CornerRadius="3" />
            <Border Grid.Column="4" Height="6" Background="#1565C0" CornerRadius="3" />
            <Border Grid.Column="6" Height="6" Background="#CCCCCC" CornerRadius="3" />
        </Grid>
        <TextBlock
            Grid.Row="2"
            Margin="0,2,0,12"
            FontSize="11"
            Foreground="#777777"
            Text="Step 3 of 4 — Validate" />

        <!-- ── Body ─────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="3" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="Bold" Text="Confirm Job Details" />

                <!-- Job summary card -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" FontSize="10" FontWeight="Bold" Foreground="#1565C0" Text="INFOR VISUAL — RETRIEVED DATA" />
                        <Rectangle Height="1" Fill="#E8E8E8" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" Foreground="#777777" Text="Workstation" />
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13" FontWeight="Bold" Text="PRESS-07" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" FontSize="13" Foreground="#777777" Text="Work Order" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" FontSize="13" FontWeight="Bold" Text="WO-123456" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" FontSize="13" Foreground="#777777" Text="Sequence" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" FontSize="13" FontWeight="Bold" Text="Seq 20" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" FontSize="13" Foreground="#777777" Text="Part" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" FontSize="13" FontWeight="Bold" Text="98765-B" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" FontSize="13" Foreground="#777777" Text="Part Type" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" FontSize="13" Text="Finished Goods" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,10,0,0" FontSize="13" Foreground="#777777" Text="WO Status" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" FontSize="13" Text="Open" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Subordinate parts -->
                <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="Bold" Text="Subordinate Parts" />

                <Border Margin="0,0,0,8" Padding="14" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" FontWeight="Bold" Text="COIL-4412" />
                            <TextBlock FontSize="12" Foreground="#555555" Text="HR Coil Stock" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock FontSize="12" Foreground="#777777" HorizontalAlignment="Right" Text="Req: 1" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" Text="On Hand: 14" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,8" Padding="14" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" FontWeight="Bold" Text="BLANK-221" />
                            <TextBlock FontSize="12" Foreground="#555555" Text="Stamped Blank" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock FontSize="12" Foreground="#777777" HorizontalAlignment="Right" Text="Req: 500" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" Text="On Hand: 1,250" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,8" Padding="14" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" FontWeight="Bold" Text="LUB-003" />
                            <TextBlock FontSize="12" Foreground="#555555" Text="Press Lubricant" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock FontSize="12" Foreground="#777777" HorizontalAlignment="Right" Text="Req: 2" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right" Text="On Hand: 8" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer nav ─────────────────────────────────────────── -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Height="52" Background="#EEEEEE" Content="← Change" FontSize="13" Foreground="#333333" />
            <Button Grid.Column="2" Height="52" Background="#388E3C" Content="✔  Approve" FontSize="15" Foreground="White" />
        </Grid>

    </Grid>

</UserControl>

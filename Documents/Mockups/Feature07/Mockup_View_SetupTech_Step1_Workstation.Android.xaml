<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="400"
    Background="#F0F2F5" x:Class="App1.MainWindow" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:DesignWidth="430" d:DesignHeight="932" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Page title ──────────────────────────────────────────── -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="18"
            FontWeight="Bold"
            Text="New Job Setup" />

        <!-- ── Progress bar: step 1 of 4 ──────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="6" Background="#1565C0" CornerRadius="3" />
            <Border Grid.Column="2" Height="6" Background="#CCCCCC" CornerRadius="3" />
            <Border Grid.Column="4" Height="6" Background="#CCCCCC" CornerRadius="3" />
            <Border Grid.Column="6" Height="6" Background="#CCCCCC" CornerRadius="3" />
        </Grid>
        <TextBlock
            Grid.Row="2"
            Margin="0,2,0,12"
            FontSize="11"
            Foreground="#777777"
            Text="Step 1 of 4 — Select Workstation" />

        <!-- ── Workstation list ──────────────────────────────────── -->
        <ScrollViewer Grid.Row="3" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Search box -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12,8"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="5" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>                            
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" BorderThickness="1" FontSize="14" Text="" />
                    <Button Grid.Column="1" Width="34" Height="34" Content="🔎" />
                    </Grid>
                </Border>

                <!-- Selected row -->
                <Border
                    Height="64"
                    Margin="0,0,0,8"
                    Padding="16,0"
                    Background="#E3F2FD"
                    BorderBrush="#1565C0"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="Bold" Text="PRESS-07" />
                            <TextBlock FontSize="12" Foreground="#555555" Text="Zone A" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#1565C0"
                            Text="✔" />
                    </Grid>
                </Border>

                <Border Height="64" Margin="0,0,0,8" Padding="16,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="PRESS-14" />
                        <TextBlock FontSize="12" Foreground="#777777" Text="Zone A" />
                    </StackPanel>
                </Border>

                <Border Height="64" Margin="0,0,0,8" Padding="16,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="PRESS-22" />
                        <TextBlock FontSize="12" Foreground="#777777" Text="Zone B" />
                    </StackPanel>
                </Border>

                <Border Height="64" Margin="0,0,0,8" Padding="16,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="PRESS-31" />
                        <TextBlock FontSize="12" Foreground="#777777" Text="Zone B" />
                    </StackPanel>
                </Border>

                <Border Height="64" Margin="0,0,0,8" Padding="16,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="PRESS-45" />
                        <TextBlock FontSize="12" Foreground="#777777" Text="Zone C" />
                    </StackPanel>
                </Border>

                <!-- Active job notice -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="#FFF3E0"
                    BorderBrush="#E65100"
                    BorderThickness="1"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="12"
                        Foreground="#BF360C"
                        Text="⚠  PRESS-07 is currently running WO-098765 / Seq 20. Continuing will archive that job to history."
                        TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Continue button ────────────────────────────────────── -->
        <Button
            Grid.Row="4"
            Height="52"
            Background="#1565C0"
            Content="Continue →"
            FontSize="15"
            Foreground="White" />

    </Grid>

</Window>
